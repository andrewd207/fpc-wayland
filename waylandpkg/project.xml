<?xml version="1.0" encoding="UTF-8"?>
<project>
  <name>wayland</name>
  <version>1.0.0</version>
  <author>Andrew Haines</author>
  <license>GPL-2.0-or-later</license>
  <description>Free Pascal bindings for libwayland (client, cursor, egl) and the core wayland protocol.</description>

  <build>
    <packaging>library</packaging>
  </build>

  <units>
    <unit>wayland_util</unit>
